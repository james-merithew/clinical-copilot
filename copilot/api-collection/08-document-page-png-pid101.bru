meta {
  name: 08 Document page PNG (pid 101)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/documents/{{documentId}}/page/1.png?pid=101&scale=2.0
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

params:query {
  pid: 101
  scale: 2.0
}

docs {
  Server-rendered page image for the bbox overlay (click-to-source). pypdfium2
  renders page 1 of the document to a PNG, LRU-cached. The UI draws the citation
  bounding boxes as percentage-positioned divs over this image (solid border =
  text-layer verified, dashed = VLM approximate).

  `pid` is required and the document<->patient ownership check runs BEFORE the
  cache is consulted on every request (a warm cache hit is never a shortcut around
  authorization). `scale` (0.5-4.0) trades sharpness for size. Response is
  image/png bytes, not JSON.
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq image/png
}
