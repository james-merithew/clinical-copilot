# Clinical Co-Pilot sidecar — env template (Week 2). Copy to copilot/.env
# (git-ignored) and fill in real values. NEVER commit the filled-in .env.
# Names/defaults source of truth: copilot/app/config.py — every field also
# accepts the bare, unprefixed name Railway injects (AliasChoices).

# --- Database: READ-ONLY user (invariant #3); local development-easy-light stack on :8320 ---
COPILOT_DB_HOST=127.0.0.1
COPILOT_DB_PORT=8320
COPILOT_DB_USER=copilot_ro
COPILOT_DB_PASSWORD=changeme
COPILOT_DB_NAME=openemr

# --- LLM (Anthropic; assume BAA + zero-data-retention) ---
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-sonnet-5
COPILOT_MOCK_LLM=false                # true = deterministic mock graph (load tests / hermetic evals)

# --- Observability (LangSmith; optional — tracing degrades to structured logs) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clinical-copilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Behaviour / identity (server-pinned; never taken from the client) ---
COPILOT_DEMO_USER_ID=1
COPILOT_DEFAULT_PID=101
COPILOT_RATE_LIMIT_PER_MIN=30
COPILOT_REQUEST_DEADLINE_S=20

# --- Authentication: Week 2 session tokens (copilot/AUTH_TOKEN_SPEC.md) ---
COPILOT_AUTH_DEV_MODE=false           # LOCAL ONLY — true exposes /dev/token; MUST be false in production
COPILOT_TOKEN_TTL_S=900               # session-token lifetime (seconds)
#COPILOT_DEV_SIGNING_KEY=             # dev-mode-only HMAC fallback; leave unset (real key lives in the copilot_signing_key DB row)
COPILOT_BEARER_SECRET=                # legacy/revoked Week-1 static bearer; keep inert (rotate on prod)

# --- Guideline retrieval (hybrid RAG; empty Cohere key = keyless TF-IDF/noop fallback) ---
COHERE_API_KEY=
COPILOT_EMBED_PROVIDER=auto           # auto | cohere | local
COPILOT_RERANK_PROVIDER=auto          # auto | cohere | claude | noop
COPILOT_RETRIEVAL_TOP_K=5

# --- Supervisor graph (bounded routing/worker budgets) ---
COPILOT_SUPERVISOR_MAX_ROUTES=4
COPILOT_WORKER_MAX_ITERS=3
# Per-node model tiers (latency tuning; empty = inherit ANTHROPIC_MODEL).
# Routing/worker calls don't need answerer-class reasoning — the verifier is
# the quality guarantee. Recommended: a Haiku-class model for both.
COPILOT_SUPERVISOR_MODEL=
COPILOT_WORKER_MODEL=
COPILOT_ANSWERER_MODEL=

# --- Eval judge (never part of the CI gate) ---
COPILOT_JUDGE=stub                    # stub (hermetic default) | live (--live LLM spot checks)

# --- Document ingestion (off by default; INSERT-only writer, separate from copilot_ro) ---
COPILOT_INGEST_ENABLED=false
COPILOT_INGEST_MAX_FILE_MB=10
COPILOT_EXTRACT_MAX_RETRIES=2
#COPILOT_EXTRACT_MODEL=               # unset = reuse ANTHROPIC_MODEL for vision extraction
COPILOT_INGEST_DB_USER=copilot_ingest
COPILOT_INGEST_DB_PASSWORD=changeme   # must match live_seed.sql's __INGEST_PASS__
COPILOT_INGEST_DB_DOC_FALLBACK=false  # direct documents-row insert when the OAuth2 REST path is unavailable
COPILOT_INGEST_ALLOW_UNVERIFIED=false # keep false — unverified extracted values are never persisted (fail-closed)

# --- OpenEMR REST API (OAuth2 front door for document upload/download) ---
OPENEMR_BASE_URL=
COPILOT_OPENEMR_OAUTH_CLIENT_ID=
COPILOT_OPENEMR_OAUTH_CLIENT_SECRET=
COPILOT_OPENEMR_API_USERNAME=
COPILOT_OPENEMR_API_PASSWORD=
