{
  "components": {
    "schemas": {
      "Body_ingest_ingest_post": {
        "properties": {
          "doc_type": {
            "title": "Doc Type",
            "type": "string"
          },
          "file": {
            "format": "binary",
            "title": "File",
            "type": "string"
          },
          "pid": {
            "title": "Pid",
            "type": "integer"
          }
        },
        "required": [
          "file",
          "pid",
          "doc_type"
        ],
        "title": "Body_ingest_ingest_post",
        "type": "object"
      },
      "ChatRequest": {
        "description": "A turn arrives as free text OR a chip tap. Both are first-class and\nresolve to the same agent + tools (W1_ARCHITECTURE.md §6). Exactly one of\n`message` / `chip_intent` is set per turn.\n\nNOTE: there is deliberately **no `user_id`** here. The requesting identity is\nNEVER taken from the client (it would be trivially spoofable on a public\nendpoint). It is pinned server-side at the Authorization Gateway (demo) or\nderived from an OpenEMR-validated token (production). The client may only\nchoose the patient `pid`.",
        "properties": {
          "chip_intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChipIntent"
              },
              {
                "type": "null"
              }
            ]
          },
          "chip_params": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Chip Params",
            "type": "object"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "title": "History",
            "type": "array"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "pid": {
            "description": "Single-patient scope",
            "title": "Pid",
            "type": "integer"
          }
        },
        "required": [
          "pid"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatTurn": {
        "description": "One prior turn, for multi-turn context (no raw PHI persisted server-side;\nthe client replays visible history).",
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "role",
          "text"
        ],
        "title": "ChatTurn",
        "type": "object"
      },
      "ChipIntent": {
        "enum": [
          "explain_care_transition",
          "lab_trend",
          "med_detail",
          "care_gaps"
        ],
        "title": "ChipIntent",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Clinical Co-Pilot",
